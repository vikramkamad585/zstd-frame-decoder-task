FROM rust:1.83.0-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 && rm -rf /var/lib/apt/lists/*
COPY zstd-1.5.6.tar.gz /tmp/
RUN cd /tmp && tar xzf zstd-1.5.6.tar.gz && cd zstd-1.5.6 && make -j8 -C programs zstd >/dev/null && cp programs/zstd /usr/local/bin/zstd && zstd --version
